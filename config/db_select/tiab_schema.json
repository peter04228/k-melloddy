      "type": "string"
    },
    "quote": {
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "relevance_class": {
      "enum": [
        "keyword_only",
        "exposure_toxicity",
        "uncertain_exposure_toxicity"
      ]
