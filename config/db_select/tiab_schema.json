            "type": "array"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "public_status": {
            "enum": [
              "unknown",
              "reported_public",
              "verified_public",
              "restricted",
              "not_public"
            ]
          },
          "relationship": {
            "enum": [
              "reuse",
              "new",
              "derived",
              "unknown"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification_level": {
